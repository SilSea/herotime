# Local development (pnpm dev) and docker compose read these.
DATABASE_URL=postgresql://herotime:herotime@localhost:5432/herotime
REDIS_URL=redis://localhost:6379
PORT=3000

# Required when NODE_ENV=production (docker compose sets it): at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32+-chars
# Required in production: origins allowed to call the API (comma separated).
CORS_ORIGIN=http://localhost:3000

# Which content to play: prototype (quick to tweak) or production.
CONTENT_SET=prototype
# Accounts that can open the content editor (comma separated, case-insensitive). Roles are never taken from sign-up requests.
ADMIN_USERS=
# 1 = publish CONTENT_SET as a new version even if the database already has content (normally the newest published version is used).
CONTENT_RESEED=0

# Practice queue (1 human + bots, fast timers): on by default outside production.
PRACTICE=1
# 1 = squeeze every timer so a whole match takes about a minute.
HEROTIME_FAST=0
